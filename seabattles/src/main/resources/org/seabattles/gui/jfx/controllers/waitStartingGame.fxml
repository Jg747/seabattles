<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.seabattles.gui.jfx.controllers.WaitStartingGame">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label fx:id="title" ellipsisString="" text="TITLE" textOverrun="CLIP" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="72.0" />
               </font>
            </Label>
         </top>
         <center>
            <BorderPane BorderPane.alignment="CENTER">
               <top>
                  <Label text="Player list" BorderPane.alignment="CENTER">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
               </top>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <center>
                  <VBox fx:id="playerList" alignment="TOP_CENTER" spacing="10.0" style="-fx-border-color: black;" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets bottom="5.0" left="50.0" right="50.0" top="5.0" />
                     </BorderPane.margin>
                  </VBox>
               </center>
            </BorderPane>
         </center>
         <bottom>
            <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <center>
                  <BorderPane prefHeight="200.0" prefWidth="400.0" style="-fx-border-color: black;" BorderPane.alignment="CENTER">
                     <bottom>
                        <BorderPane BorderPane.alignment="CENTER">
                           <center>
                              <TextField fx:id="textSend" promptText="Chat send..." BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                                 <BorderPane.margin>
                                    <Insets left="5.0" right="10.0" />
                                 </BorderPane.margin>
                              </TextField>
                           </center>
                           <right>
                              <Button fx:id="sendChat" mnemonicParsing="false" text="Send" BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                                 <BorderPane.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </BorderPane.margin>
                              </Button>
                           </right>
                        </BorderPane>
                     </bottom>
                     <BorderPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </BorderPane.margin>
                     <center>
                        <ScrollPane fx:id="pane" BorderPane.alignment="CENTER">
                           <content>
                              <VBox fx:id="chat" />
                           </content>
                        </ScrollPane>
                     </center>
                  </BorderPane>
               </center>
               <top>
                  <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
                     <children>
                        <Button fx:id="quitBtn" mnemonicParsing="false" prefWidth="400.0" text="Leave">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Button>
                        <Button fx:id="startGameBtn" mnemonicParsing="false" prefWidth="400.0" text="Start Game">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </top>
            </BorderPane>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
