<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.seabattles.gui.jfx.controllers.MainMenuController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label fx:id="title" ellipsisString="" text="TITLE" textOverrun="CLIP" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="72.0" />
               </font>
            </Label>
         </top>
         <center>
            <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <center>
                  <VBox alignment="CENTER" BorderPane.alignment="CENTER">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <BorderPane.margin>
                        <Insets />
                     </BorderPane.margin>
                     <children>
                        <BorderPane>
                           <center>
                              <Button fx:id="singleBtn" alignment="CENTER" mnemonicParsing="false" onAction="#singleplayer" prefWidth="500.0" text="SINGLEPLAYER" textAlignment="CENTER" BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="40.0" />
                                 </font>
                              </Button>
                           </center>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </BorderPane>
                        <BorderPane>
                           <center>
                              <Button fx:id="multiBtn" alignment="CENTER" mnemonicParsing="false" onAction="#multiplayer" prefWidth="500.0" text="MULTIPLAYER" textAlignment="CENTER" BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="40.0" />
                                 </font>
                              </Button>
                           </center>
                           <VBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </VBox.margin>
                        </BorderPane>
                        <BorderPane>
                           <center>
                              <Button fx:id="exitBtn" alignment="CENTER" mnemonicParsing="false" onAction="#exitAction" prefWidth="500.0" text="EXIT" textAlignment="CENTER" BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="40.0" />
                                 </font>
                              </Button>
                           </center>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </BorderPane>
                     </children>
                  </VBox>
               </center>
            </BorderPane>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
