<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.seabattles.gui.jfx.controllers.PlaceShipsController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label fx:id="title" ellipsisString="" text="TITLE" textOverrun="CLIP" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="72.0" />
               </font>
            </Label>
         </top>
         <center>
            <HBox alignment="CENTER" BorderPane.alignment="CENTER">
               <children>
                  <VBox fx:id="boardVBox" alignment="TOP_CENTER">
                     <children>
                        <Label text="PLACE YOUR SHIPS">
                           <font>
                              <Font name="System Bold" size="36.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="TOP_CENTER" prefWidth="300.0">
                     <children>
                        <Label text="Available ships">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                        </Label>
                        <ScrollPane fx:id="shipsDisplayWrap" style="-fx-background-color: transparent;">
                           <VBox.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </VBox.margin>
                           <content>
                              <VBox fx:id="shipsDisplay" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </center>
         <bottom>
            <BorderPane fx:id="footer" prefHeight="200.0" prefWidth="400.0" BorderPane.alignment="CENTER">
               <bottom>
                  <BorderPane BorderPane.alignment="CENTER">
                     <center>
                        <TextField fx:id="textSend" promptText="Chat send..." BorderPane.alignment="CENTER">
                           <font>
                              <Font size="24.0" />
                           </font>
                           <BorderPane.margin>
                              <Insets left="5.0" right="10.0" />
                           </BorderPane.margin>
                        </TextField>
                     </center>
                     <right>
                        <Button fx:id="sendChat" mnemonicParsing="false" text="Send" BorderPane.alignment="CENTER">
                           <font>
                              <Font size="24.0" />
                           </font>
                           <BorderPane.margin>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </BorderPane.margin>
                        </Button>
                     </right>
                  </BorderPane>
               </bottom>
               <center>
                  <ScrollPane fx:id="chatScrollPane" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
                     <content>
                        <VBox fx:id="chat" />
                     </content>
                     <BorderPane.margin>
                        <Insets top="5.0" />
                     </BorderPane.margin>
                  </ScrollPane>
               </center>
               <top>
                  <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
                     <children>
                        <Button fx:id="quitBtn" mnemonicParsing="false" prefWidth="400.0" text="Leave">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Button>
                        <Button fx:id="sendBtn" mnemonicParsing="false" prefWidth="400.0" text="Confirm placement">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Button>
                     </children>
                     <BorderPane.margin>
                        <Insets top="5.0" />
                     </BorderPane.margin>
                  </HBox>
               </top>
               <BorderPane.margin>
                  <Insets top="5.0" />
               </BorderPane.margin>
            </BorderPane>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
