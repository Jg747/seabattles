<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.seabattles.gui.jfx.controllers.ViewFieldsAndAttackController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label fx:id="title" ellipsisString="" text="TITLE" textOverrun="CLIP" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="72.0" />
               </font>
            </Label>
         </top>
         <center>
            <HBox alignment="CENTER" BorderPane.alignment="CENTER">
               <children>
                  <TabPane fx:id="boardsView" tabClosingPolicy="UNAVAILABLE" />
                  <StackPane fx:id="turnDisplay">
                     <children>
                        <VBox alignment="CENTER">
                           <children>
                              <Label text="TURN">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font></Label>
                              <VBox fx:id="turnSelector" />
                              <Button fx:id="backBtn" mnemonicParsing="false" text="BACK">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <VBox fx:id="chatParent" alignment="TOP_CENTER" prefWidth="300.0">
                     <children>
                        <Label text="Chat">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <ScrollPane fx:id="chatScrollPane" style="-fx-background-color: transparent;">
                           <content>
                              <VBox fx:id="chat" />
                           </content>
                        </ScrollPane>
                        <BorderPane>
                           <center>
                              <TextField fx:id="textSend" promptText="Chat send..." BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                                 <BorderPane.margin>
                                    <Insets left="5.0" right="10.0" />
                                 </BorderPane.margin>
                              </TextField>
                           </center>
                           <right>
                              <Button fx:id="sendChat" mnemonicParsing="false" text="Send" BorderPane.alignment="CENTER">
                                 <font>
                                    <Font size="24.0" />
                                 </font>
                                 <BorderPane.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </BorderPane.margin>
                              </Button>
                           </right>
                        </BorderPane>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
